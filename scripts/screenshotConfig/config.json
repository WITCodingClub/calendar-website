{
	"data": "calendar.json",
	"date": "2026-10-06T12:00:00-04:00",
	"viewport": {
		"width": 1280,
		"height": 900
	},
	"settings": {
		"military_time": false,
		"default_color_lecture": "#3f51b5",
		"default_color_lab": "#0b8043",
		"advanced_editing": false
	},
	"targets": {
		"classButton": {
			"role": "button",
			"name": "Object-Oriented Design",
			"exact": false,
			"index": 0
		},
		"classDialog": {
			"role": "dialog",
			"name": "Edit Calendar Event"
		},
		"saveButton": {
			"role": "button",
			"name": "Save changes",
			"within": "@classDialog"
		},
		"googleAccounts": "section > div:has(> div > h2:text-is(\"Connected Google accounts\"))",
		"timeFormat": {
			"role": "heading",
			"name": "Time format"
		},
		"welcomeInfo": "div:has(> p:text-is(\"Welcome! A few things to note:\"))",
		"termChips": ".m3-container:has(> input[name=\"panel-term\"])",
		"lectureColorRow": "div:has(> h3:text-is(\"Default lecture color\"))",
		"calendarLinkRow": "div:has(> div > h3:text-is(\"Calendar link\"))",
		"lectureColor": {
			"label": "Default lecture color"
		},
		"universityEvents": "section:has(h2:text-is(\"Sync university events\"))",
		"manualFields": {
			"css": "div.grid:has(input):has(textarea)",
			"within": "@classDialog"
		},
		"reminders": {
			"css": "section:has(h2:text-is(\"Reminders\"))",
			"within": "@classDialog"
		},
		"manageFriendsButton": {
			"role": "button",
			"name": "Manage friends"
		},
		"manageFriends": {
			"role": "dialog",
			"name": "Manage friends"
		},
		"manageGroupsTab": {
			"css": "label:has-text(\"Groups\")",
			"within": "@manageFriends"
		},
		"manageRequestsTab": {
			"css": "label:has-text(\"Requests\")",
			"within": "@manageFriends"
		},
		"manageListItem": {
			"css": "li > button",
			"within": "@manageFriends",
			"index": 0
		},
		"planner": {
			"role": "region",
			"name": "Friends planning"
		},
		"plannerFilters": {
			"css": "[aria-label=\"Planning preferences\"]",
			"within": "@planner"
		},
		"suggestedTimes": {
			"role": "region",
			"name": "Suggested times"
		},
		"firstSuggestedTime": {
			"css": "button",
			"within": "@suggestedTimes",
			"index": 0
		},
		"peoplePicker": {
			"role": "dialog",
			"name": "Select people"
		},
		"firstPickerGroup": {
			"css": "label:has(input[type=\"checkbox\"])",
			"within": "@peoplePicker",
			"index": 0
		},
		"compareButton": {
			"role": "button",
			"name": "Compare calendars",
			"within": "@planner"
		},
		"comparison": "section.comparison",
		"meetingEditor": {
			"role": "dialog",
			"name": "Create meeting"
		},
		"savedMeetings": {
			"role": "region",
			"name": "Saved meetings"
		},
		"meetingDetails": {
			"role": "dialog",
			"name": "Meeting details"
		},
		"meetingLinks": {
			"role": "region",
			"name": "One-time meeting links"
		},
		"meetingLinkEditor": {
			"role": "dialog",
			"name": "Create meeting link"
		},
		"copyGuestLink": {
			"role": "button",
			"name": "Copy guest link"
		},
		"meetingLinkCreated": "dialog[open]:has(button:has-text(\"Copy guest link\"))"
	},
	"quickActions": {
		"calendarReady": [
			{
				"action": "waitFor",
				"target": "@classButton"
			}
		],
		"openClassDetails": [
			"calendarReady",
			{
				"action": "click",
				"target": "@classButton"
			},
			{
				"action": "waitFor",
				"target": "@saveButton"
			}
		],
		"friendsReady": [
			{
				"action": "waitFor",
				"target": "@planner"
			}
		],
		"selectFriends": [
			"friendsReady",
			{
				"action": "click",
				"target": {
					"role": "button",
					"name": "Edit people",
					"exact": false,
					"within": "@planner"
				}
			},
			{
				"action": "click",
				"target": "@firstPickerGroup"
			},
			{
				"action": "click",
				"target": {
					"role": "button",
					"name": "Done",
					"within": "@peoplePicker"
				}
			},
			{
				"action": "waitFor",
				"target": "@firstSuggestedTime"
			}
		],
		"openManageFriends": [
			"friendsReady",
			{
				"action": "click",
				"target": "@manageFriendsButton"
			},
			{
				"action": "waitFor",
				"target": "@manageFriends"
			}
		],
		"openComparison": [
			"selectFriends",
			{
				"action": "click",
				"target": "@compareButton"
			},
			{
				"action": "waitFor",
				"target": "@comparison"
			}
		]
	},
